rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: is the caller signed in with a real account (not anonymous)?
    // Arena uses anonymous sign-in for guest mode, which can play
    // ephemeral rooms but MUST NOT touch persistent collections
    // (leaderboard, H2H, daily, users/{uid}).
    function isRegistered() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Helper: is the caller connected to this MapTap Rivals member?
    //
    // The pair link doc id is the two uids sorted lexicographically and
    // joined by '__' (see pairKey() in apps/maptap-rivals/js/app.js). The
    // sort is re-derived here rather than probing both orderings, because
    // the create rule below now REQUIRES the canonical key: a forged id can
    // no longer exist, so there is only one path to look at.
    //
    // ACCEPTANCE (2026-09-07). A link used to grant private-profile access
    // the moment it existed, and anyone could create one naming themselves
    // and a stranger - so "only connected rivals can read your profile"
    // protected nothing: the stranger simply created the connection. A link
    // now records who has accepted it, and only a MUTUALLY accepted link
    // grants a read.
    //
    // Links written before this change carry no acceptedBy field and are
    // honoured as accepted. Breaking every existing connection to close a
    // hole that is already closed for new ones would cost real users their
    // rival network; the create rule is what stops a new unilateral link.
    function pairPath(a, b) {
      return /databases/$(database)/documents/maptapRivalsLinks/$(a < b ? a + '__' + b : b + '__' + a);
    }
    function linkAccepted(d) {
      return d.get('acceptedBy', null) == null || d.acceptedBy.size() >= 2;
    }
    function isLinkedTo(otherUid) {
      return exists(pairPath(request.auth.uid, otherUid))
        && linkAccepted(get(pairPath(request.auth.uid, otherUid)).data);
    }

    // Users can only read/write their own data. Anonymous users have no
    // persistent profile, so we explicitly block them here even though
    // their uid would otherwise match — they'd just be writing garbage
    // that nobody can ever read back after the anon session expires.
    match /users/{userId} {
      allow read, write: if isRegistered() && request.auth.uid == userId;

      // Recursive rule for all subcollections and documents
      match /{document=**} {
        allow read, write: if isRegistered() && request.auth.uid == userId;
      }
    }

    // Alternative: More granular control per namespace. NOTE — this rule
    // is shadowed by the recursive /users/{userId}/{document=**} match
    // above; Firestore unions allow rules so the permissive parent
    // disables the validation here. Kept in sync with the deployed
    // ruleset so a CLI deploy from this file doesn't drift.
    match /users/{userId}/apps/{namespace} {
      allow read: if isRegistered() && request.auth.uid == userId;

      allow write: if isRegistered()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['data', 'meta'])
        && request.resource.data.meta.keys().hasAll(['lastUpdated']);
    }

    // ---------- Trivia Arena ----------
    // Multiplayer game rooms. Any signed-in user can read any room (so
    // they can join with a code). Writes follow a host-or-member model
    // (2026-08-23 remediation of the site-wide audit):
    //   - the host (room doc hostUid) may update anything and is the only
    //     principal that may delete the room doc;
    //   - any MEMBER (owns a player doc in the room) may write exactly the
    //     per-player room-doc touches the app makes: pause/resume, end the
    //     game early, rematch coordination, the decider's category pick,
    //     the timed advance once a question's asking + reveal window has
    //     elapsed on the SERVER clock (host-independent game clock), and a
    //     host takeover when the current host's player doc is gone or stale;
    //   - everything else (hostUid, status, question pointers, questions,
    //     settings) is host-only, so a non-host can no longer wedge or end a
    //     room outside those forms.
    // Liveness constants mirror apps/arena/js/config.js
    // (DISCONNECT_GRACE_MS 30000, PRESENCE_STALE_MS 120000, trivia reveal
    // 2500 ms, Globe Drop reveal 10000 ms).
    //
    // Room passwords (defect 22): a new room may NEVER carry a cleartext
    // `password` field - the room doc is world-readable to signed-in
    // users, so the old cleartext field leaked the password to anyone
    // with the code. Private rooms instead store a hash in
    // /private/gate (below). The no-password condition applies to CREATE
    // only: legacy rooms created before this rule still carry the field
    // and must stay updatable (host advances questions with updateDoc,
    // which rewrites the full post-state including the old field) until
    // they expire.
    function roomPath(code) {
      return /databases/$(database)/documents/triviaRooms/$(code);
    }
    function playerPath(code, uid) {
      return /databases/$(database)/documents/triviaRooms/$(code)/players/$(uid);
    }
    function roomGone(code) {
      return !exists(roomPath(code));
    }
    function isRoomHost(code) {
      return request.auth != null
        && exists(roomPath(code))
        && get(roomPath(code)).data.hostUid == request.auth.uid;
    }
    function isRoomMember(code) {
      return request.auth != null && exists(playerPath(code, request.auth.uid));
    }
    // Does this room keep its contents to its members?
    //
    // `scopedReads: true` is written by every room created since 2026-09-07.
    // Before it, one signed-in stranger who obtained a five-character code
    // could read the room doc (including the questions and their
    // correctIndex), the whole roster (including each member's gateHash,
    // which is a replayable admission proof) and every chat message. The
    // code is a shared secret people paste into group chats and screenshots;
    // it was never meant to be the only thing between an outsider and a
    // private room.
    //
    // Rooms created before the flag stay open. That is deliberate: they are
    // ephemeral (a room lives for one sitting), an old client cannot write
    // the flag, and locking them out would break a game already in progress
    // during the deploy. The flag is what a NEW room gets, and the boundary
    // is complete within one room's lifetime.
    function roomScoped(code) {
      return exists(roomPath(code))
        && get(roomPath(code)).data.get('scopedReads', false) == true;
    }
    // May the caller read this room's members-only content (roster, chat)?
    // Once the room doc is gone the content is orphaned and any signed-in
    // user may read it in order to sweep it, exactly as before.
    function mayReadRoomContent(code) {
      return request.auth != null && (!roomScoped(code) || isRoomMember(code));
    }
    // A player doc is stale when its owner announced a disconnect more
    // than the grace window ago, or stopped heart-beating lastSeen for
    // longer than the presence window. Mirrors RoomState.isPlayerLive.
    function isStalePlayerData(d) {
      return (d.get('disconnectedAt', null) is number
              && d.disconnectedAt < request.time.toMillis() - 30000)
        || (d.get('lastSeen', null) is timestamp
              && d.lastSeen.toMillis() < request.time.toMillis() - 120000);
    }
    function playerGone(code, uid) {
      return !exists(playerPath(code, uid))
        || isStalePlayerData(get(playerPath(code, uid)).data);
    }
    function roomKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function revealWindowMs() {
      return resource.data.get('gameType', 'trivia') == 'globe-drop' ? 10000 : 2500;
    }
    // Server-clock moment the current question is fully over (asking +
    // reveal, or early reveal + reveal). Only meaningful while playing.
    function questionOverMs() {
      return resource.data.get('revealStartedAt', null) is timestamp
        ? resource.data.revealStartedAt.toMillis() + revealWindowMs()
        : resource.data.questionStartedAt.toMillis()
            + resource.data.get('questionTimeMs', 15000) + revealWindowMs();
    }
    function memberPause() {
      return roomKeys().hasOnly(['paused', 'pausedAt', 'pausedByUid', 'pausedByName']);
    }
    function memberResume() {
      return resource.data.get('paused', false) == true
        && roomKeys().hasOnly(['paused', 'pausedAt', 'pausedByUid', 'pausedByName', 'questionStartedAt']);
    }
    // VALUE bounds for the member-write paths below.
    //
    // Every member rule used to constrain KEYS only (`affectedKeys().hasOnly`),
    // which says what may be touched and nothing about what may be written.
    // Once a question's window had elapsed on the server clock - which happens
    // every round, and lasts indefinitely if the host is gone - any member
    // could write `status: 'bogus'` or `currentQuestionIndex: -3` and wedge the
    // room, restart the current question's timer forever, hand themselves the
    // decider role, or end the game with a ranking naming themselves at
    // 999999 points. Only a member of the room, so this was griefing among
    // invited friends rather than a stranger path, but the README claimed the
    // opposite and it is cheap to close.
    function statusIsReal() {
      return request.resource.data.status in ['lobby', 'picking', 'playing', 'finished'];
    }
    // The written ranking, as far as rules can check it. There is no iteration
    // in this language, so every element cannot be validated; what IS reachable
    // is the shape, a sane length, and the TOP entry, which is the one a
    // griefer has to occupy to appear to have won (the client writes this list
    // already sorted by score, descending). A legitimate game cannot approach
    // the cap: trivia peaks at (100 base + 100 speed) x 1.5 streak = 300 a
    // question over at most 10 questions, and Globe Drop at 100 x 3.0 round
    // x 1.5 streak x ~3.0 difficulty = 1,350 a round over at most 10, so 100k
    // is roughly a 7x margin over the highest score any real game can reach.
    function rankingSane() {
      return !roomKeys().hasAny(['finalRanking'])
        || request.resource.data.finalRanking == null
        || (request.resource.data.finalRanking is list
            && request.resource.data.finalRanking.size() <= 32
            && (request.resource.data.finalRanking.size() == 0
                || (request.resource.data.finalRanking[0].score is number
                    && request.resource.data.finalRanking[0].score >= 0
                    && request.resource.data.finalRanking[0].score <= 100000)));
    }
    function memberEndGame() {
      return request.resource.data.status == 'finished'
        && rankingSane()
        && roomKeys().hasOnly(['status', 'finishedAt', 'paused', 'pausedAt', 'finalRanking']);
    }
    function memberRematch() {
      return roomKeys().hasOnly(['rematchProposedBy', 'rematchAcceptedBy', 'rematchDeclinedBy', 'rematchProposedAt']);
    }
    function deciderPick() {
      return resource.data.status == 'picking'
        && resource.data.get('deciderUid', '') == request.auth.uid
        && statusIsReal()
        && roomKeys().hasOnly(['status', 'currentQuestionId', 'selectedCategory',
                               'questionStartedAt', 'revealStartedAt', 'finishedAt']);
    }
    function advancedByOne() {
      return request.resource.data.get('currentQuestionIndex', 0)
        == resource.data.get('currentQuestionIndex', 0) + 1;
    }
    function memberTimedAdvance() {
      return resource.data.status == 'playing'
        && resource.data.get('paused', false) != true
        && resource.data.get('questionStartedAt', null) is timestamp
        && request.time.toMillis() >= questionOverMs()
        && statusIsReal()
        && rankingSane()
        // The advance does exactly one of two things, and the question index
        // says which: it FINISHES the game (index unchanged), or it moves on
        // to the next question (index exactly one higher). Anything else is
        // not an advance. This is also what stops a member replaying the
        // CURRENT question forever by rewriting `questionStartedAt` while the
        // status stays 'playing' and the index stays put.
        && ((request.resource.data.status == 'finished'
             && request.resource.data.get('currentQuestionIndex', 0)
                == resource.data.get('currentQuestionIndex', 0))
            || (request.resource.data.status in ['playing', 'picking'] && advancedByOne()))
        // The decider rotation is only ever written as part of moving to the
        // next question, so a member cannot hand themselves the pick without
        // advancing the room.
        && (!roomKeys().hasAny(['playerOrder', 'deciderUid']) || advancedByOne())
        && roomKeys().hasOnly(['status', 'currentQuestionIndex', 'currentQuestionId', 'selectedCategory',
                               'questionStartedAt', 'revealStartedAt', 'pickingStartedAt', 'playerOrder',
                               'deciderUid', 'playedQuestionIds', 'finishedAt', 'finalRanking',
                               'paused', 'pausedAt']);
    }
    // Picking-stage deadline (PICK_DEADLINE_MS in apps/arena/js/config.js):
    // once it passes, ANY member may pick for the room so a decider who
    // never chooses cannot stall it forever. The pick itself is
    // deterministic client-side, and the write is the same shape the
    // decider's own pick uses.
    function memberTimedPick() {
      return resource.data.status == 'picking'
        && resource.data.get('pickingStartedAt', null) is timestamp
        && request.time.toMillis() >= resource.data.pickingStartedAt.toMillis() + 20000
        // A pick either starts the question it chose or finishes a game whose
        // pool is exhausted. It never returns the room to the lobby, and the
        // question index is not among the keys it may touch at all.
        && request.resource.data.status in ['playing', 'finished']
        && rankingSane()
        && roomKeys().hasOnly(['status', 'currentQuestionId', 'selectedCategory',
                               'questionStartedAt', 'revealStartedAt', 'finishedAt', 'finalRanking']);
    }
    function memberHostTakeover(code) {
      return roomKeys().hasOnly(['hostUid'])
        && request.resource.data.hostUid == request.auth.uid
        && playerGone(code, resource.data.hostUid);
    }
    match /triviaRooms/{roomCode} {
      // `resource == null` is allowed on purpose: a read of a room that does
      // not exist must answer "not found" rather than erroring on
      // resource.data and denying, which is what reserveUniqueRoomCode and
      // "Room not found." both depend on. It reveals only whether a code is
      // taken, never anything inside the room.
      allow read: if request.auth != null
        && (resource == null
            || resource.data.get('scopedReads', false) != true
            || isRoomMember(roomCode));
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && !request.resource.data.keys().hasAny(['password']);
      allow update: if request.auth != null
        && (resource.data.hostUid == request.auth.uid
            || (isRoomMember(roomCode)
                && (memberPause() || memberResume() || memberEndGame() || memberRematch()
                    || deciderPick() || memberTimedAdvance() || memberTimedPick()
                    || memberHostTakeover(roomCode))));
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }
    // The one thing about a room that a NON-member is allowed to learn:
    // whether it exists, whether it wants a password, and which game it is.
    // Everything a joiner needs to reach the join form, and nothing else.
    //
    // Deliberately IMMUTABLE (no update rule). Mirroring the room's live
    // status here would mean re-writing this document on every question
    // advance and every stage change - a second write on the hot path of a
    // real-time game, and a second place for state to be wrong. Everything
    // that changes during play is read from the room doc, which the joiner
    // can read the moment their player doc exists.
    match /triviaRooms/{roomCode}/public/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && docId == 'lobby'
        && isRoomHost(roomCode)
        && request.resource.data.keys().hasOnly(['isPrivate', 'gameType'])
        && request.resource.data.isPrivate is bool
        && request.resource.data.gameType is string
        && request.resource.data.gameType.size() <= 32;
      allow update: if false;
      // Same lifecycle as the gate: the host while the room lives, anyone
      // once the room doc is gone (orphan sweep).
      allow delete: if request.auth != null && (roomGone(roomCode) || isRoomHost(roomCode));
    }

    // Password gate for private rooms: { hash: SHA-256(password + ':' +
    // code) }. Readable by NOBODY - the member-create rule below reads it
    // via get(), which bypasses client read permissions, so the hash (and
    // a fortiori the password) never becomes client-readable through this
    // doc. Only the room's creator can write it, exactly once (no
    // updates: a host swapping the hash mid-game would lock the room in a
    // way the UI never offers).
    //
    // DELETE is the lifecycle point that used to be a password bypass
    // (2026-08-22 audit D1: any signed-in user could delete the gate and the
    // member-create rule's `!exists(gate)` branch then admitted anyone).
    // The gate may be deleted only by the room host while the room doc
    // exists, or by any signed-in user once the room doc is gone (orphan
    // sweep). The client deletes the room doc FIRST, then sweeps the gate,
    // chat and leftover player docs under that second branch.
    match /triviaRooms/{roomCode}/private/{gateDoc} {
      allow read: if false;
      allow create: if request.auth != null
        && gateDoc == 'gate'
        && get(/databases/$(database)/documents/triviaRooms/$(roomCode)).data.hostUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['hash'])
        && request.resource.data.hash is string;
      allow update: if false;
      allow delete: if request.auth != null && (roomGone(roomCode) || isRoomHost(roomCode));
    }
    // Each player owns their own player doc. Score increments and answer
    // writes happen here under the player's own uid - the host can't
    // silently rewrite someone else's score.
    //
    // CREATE additionally enforces the password gate: when a
    // /private/gate doc exists, the joiner must present a matching
    // gateHash field (derived client-side from the typed password). A
    // missing or wrong hash errors the comparison, which denies. Rooms
    // without a gate doc (public rooms, plus legacy password rooms that
    // predate the gate and still use the client-side cleartext compare)
    // join exactly as before. Updates are exempt on purpose: an existing
    // player doc means the gate was already passed (reconnect-with-grace
    // rides setDoc/updateDoc on the surviving doc).
    //
    // DELETE: the owner always; the host may sweep a STALE doc (ghost
    // player past the disconnect grace or presence window); anyone signed
    // in may sweep leftovers once the room doc is gone.
    match /triviaRooms/{roomCode}/players/{playerUid} {
      // `get` on YOUR OWN doc is always allowed - that is the membership
      // probe every rejoin path starts with, and it has to answer on a
      // document that may not exist. Reading anyone ELSE's player doc, and
      // listing the roster at all, needs membership in a scoped room: the
      // roster is where the gateHash lived, and a readable admission proof
      // is a replayable one.
      allow get: if request.auth != null
        && (request.auth.uid == playerUid || mayReadRoomContent(roomCode));
      allow list: if mayReadRoomContent(roomCode);
      allow create: if request.auth != null
        && request.auth.uid == playerUid
        // No joining a room that is not there. Without this a player doc
        // could be created under any five-character string, leaving a
        // subcollection nobody owns and nobody sweeps.
        && exists(roomPath(roomCode))
        && (!exists(/databases/$(database)/documents/triviaRooms/$(roomCode)/private/gate)
            || request.resource.data.gateHash ==
               get(/databases/$(database)/documents/triviaRooms/$(roomCode)/private/gate).data.hash);
      allow update: if request.auth != null
        && request.auth.uid == playerUid;
      allow delete: if request.auth != null
        && (request.auth.uid == playerUid
            || roomGone(roomCode)
            || (isStalePlayerData(resource.data) && isRoomHost(roomCode)));
    }

    // Per-room chat. Any signed-in user can read; each user can only
    // write messages keyed by their own uid in the payload. We cap the
    // text at 280 characters so a runaway client can't spam the doc
    // with megabytes; the rules-side check is the last line of defense
    // (the client also enforces this).
    match /triviaRooms/{roomCode}/chat/{messageId} {
      // Members only, both ways. An outsider used to be able to read a
      // private room's whole conversation AND post into it without ever
      // joining: the create rule checked the author's uid and the text
      // length, never whether the author was in the room.
      allow read: if mayReadRoomContent(roomCode);
      allow create: if request.auth != null
        && isRoomMember(roomCode)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 280;
      // No edits, no recalls while the room lives - chat stays append-only
      // so moderation is tractable. Once the room doc is deleted (last
      // player left) the messages are orphans and any signed-in user may
      // sweep them; the last leaver does so right after deleting the room.
      allow update: if false;
      allow delete: if request.auth != null && roomGone(roomCode);
    }

    // ---------- persistent-record bounds ----------
    //
    // Arena scores are computed on the client, so a persistent row is a
    // CLAIM, not a measurement. Nothing here can make it a measurement -
    // that needs an authoritative server this project deliberately does not
    // run - and the product no longer says otherwise (the leaderboard is
    // labelled self-reported in the UI and in privacy.html).
    //
    // What these bounds DO buy is the difference between a claim and a
    // fabrication. The audit wrote a synthetic score of 999,999,999 and the
    // rules took it; a single row like that makes the whole board
    // meaningless to everyone else. So: one game per write, a per-game
    // ceiling far above anything the scoring can produce (a 10-question
    // trivia round tops out near 3,000; Globe Drop's per-location maximum
    // times its location cap is the same order), and counters that can only
    // go up.
    function scoreCeiling() { return 100000; }
    function isCount(v, max) { return v is int && v >= 0 && v <= max; }
    // A field that is absent on both sides, or absent-then-set, or grown by
    // at most `step`. Absent reads as 0, which is what a merge-write of a
    // partial document (propagateDisplayName) produces.
    function grewBy(field, step, max) {
      return isCount(request.resource.data.get(field, 0), max)
        && request.resource.data.get(field, 0) >= resource.data.get(field, 0)
        && request.resource.data.get(field, 0) - resource.data.get(field, 0) <= step;
    }
    function leaderboardShape() {
      return request.resource.data.get('displayName', '') is string
        && request.resource.data.get('displayName', '').size() <= 20
        && isCount(request.resource.data.get('xp', 0), 1000000000)
        && isCount(request.resource.data.get('gamesPlayed', 0), 1000000)
        && isCount(request.resource.data.get('wins', 0), 1000000)
        && isCount(request.resource.data.get('lifetimeBullseyes', 0), 10000000)
        && isCount(request.resource.data.get('bestRoundScore', 0), scoreCeiling())
        && request.resource.data.get('wins', 0) <= request.resource.data.get('gamesPlayed', 0);
    }

    // Denormalized global XP leaderboard. Read for everyone signed in
    // (guests included — they can browse the boards). Writes require a
    // real account so guest uids can't pollute the public leaderboard.
    // Admins (presence of a doc at /leaderboardAdmins/{uid}) can delete
    // any row — used to moderate stale or abusive entries.
    match /triviaLeaderboard/{userId} {
      allow read: if request.auth != null;
      allow create: if isRegistered() && request.auth.uid == userId
        && leaderboardShape()
        && request.resource.data.get('xp', 0) <= scoreCeiling()
        && request.resource.data.get('gamesPlayed', 0) <= 1
        && request.resource.data.get('wins', 0) <= 1;
      allow update: if isRegistered() && request.auth.uid == userId
        && leaderboardShape()
        // One game per write. A client that has been offline still writes
        // once per finished game, so this never blocks honest play.
        && grewBy('xp', scoreCeiling(), 1000000000)
        && grewBy('gamesPlayed', 1, 1000000)
        && grewBy('wins', 1, 1000000)
        && grewBy('lifetimeBullseyes', 1000, 10000000);
      allow delete: if isRegistered()
        && exists(/databases/$(database)/documents/leaderboardAdmins/$(request.auth.uid));
    }

    // Admin registry for leaderboard moderation. Each doc id is a uid;
    // presence (not the doc contents) grants admin power above. Bootstrap:
    // create the FIRST doc manually in the Firebase Console (anyone with
    // project-owner access can do it); from then on you can manage the
    // list there.
    match /leaderboardAdmins/{userId} {
      allow read: if request.auth != null;
      // Writes are deliberately closed — admin registry is managed via
      // the Firebase Console only, not in-app.
      allow write: if false;
    }

    // Brain Arena — Pairwise head-to-head records.
    // One doc per ordered uid pair (key = "{uidA}__{uidB}" with uidA <
    // uidB lexicographically). Holds Wins/Losses/Ties between those two
    // players across all multiplayer games. Read is open to any signed-
    // in user so the H2H view + lobby badges can fetch arbitrary pairs;
    // write requires the caller to actually be one of the two players
    // in the pair AND to be a registered (non-anonymous) user — guests
    // play ephemerally and shouldn't create H2H pair rows.
    // The participants are the DOCUMENT KEY, and both create and update are
    // authorised against them.
    //
    // The hole this closes: the old rule checked only the uids in the
    // SUBMITTED document, so an unrelated registered user could open
    // `victim-a__victim-b`, rewrite uidA to themselves, and post 9,999 wins
    // over a stranger. Ownership of the existing record was never consulted,
    // and neither was the key. Now the key must be the two participants in
    // canonical order, the caller must be one of them, and on an update the
    // participants are frozen: an existing pair's identity cannot be
    // replaced by anyone, including its own members.
    function h2hParticipantsCanonical(pairKey) {
      return request.resource.data.uidA is string
        && request.resource.data.uidB is string
        && request.resource.data.uidA < request.resource.data.uidB
        && pairKey == request.resource.data.uidA + '__' + request.resource.data.uidB;
    }
    function h2hIsMine() {
      return request.resource.data.uidA == request.auth.uid
        || request.resource.data.uidB == request.auth.uid;
    }
    function h2hShape() {
      return isCount(request.resource.data.get('winsA', 0), 1000000)
        && isCount(request.resource.data.get('winsB', 0), 1000000)
        && isCount(request.resource.data.get('ties', 0), 1000000)
        && isCount(request.resource.data.get('gamesPlayed', 0), 1000000)
        && request.resource.data.get('winsA', 0)
           + request.resource.data.get('winsB', 0)
           + request.resource.data.get('ties', 0)
           <= request.resource.data.get('gamesPlayed', 0)
        && request.resource.data.get('displayNameA', '') is string
        && request.resource.data.get('displayNameA', '').size() <= 20
        && request.resource.data.get('displayNameB', '') is string
        && request.resource.data.get('displayNameB', '').size() <= 20;
    }
    match /triviaH2H/{pairKey} {
      allow read: if request.auth != null;
      allow create: if isRegistered()
        && h2hParticipantsCanonical(pairKey)
        && h2hIsMine()
        && h2hShape()
        && request.resource.data.get('gamesPlayed', 0) <= 1;
      allow update: if isRegistered()
        // The participants of an EXISTING pair are immutable, and the caller
        // must be one of them - checked against the stored record, not the
        // submitted one.
        && request.resource.data.uidA == resource.data.uidA
        && request.resource.data.uidB == resource.data.uidB
        && (resource.data.uidA == request.auth.uid || resource.data.uidB == request.auth.uid)
        && h2hParticipantsCanonical(pairKey)
        && h2hShape()
        // One game per write, and counters that only ever go up.
        && grewBy('winsA', 1, 1000000)
        && grewBy('winsB', 1, 1000000)
        && grewBy('ties', 1, 1000000)
        && grewBy('gamesPlayed', 1, 1000000);
    }

    // Brain Arena — Globe Drop daily challenge leaderboard.
    // Each YYYY-MM-DD doc has a /scores subcollection keyed by uid.
    // Anyone signed in can read (to render the daily top 10); each
    // user can only create/update their own score entry, and must be
    // a registered (non-anonymous) user so guest uids can't claim a
    // daily top spot that would orphan as soon as their session ends.
    match /globeDropDailyLeaderboard/{date}/scores/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isRegistered() && request.auth.uid == userId
        && request.resource.data.get('displayName', '') is string
        && request.resource.data.get('displayName', '').size() <= 20
        && isCount(request.resource.data.get('score', 0), scoreCeiling())
        && isCount(request.resource.data.get('locations', 0), 1000)
        && request.resource.data.get('roundType', '') is string
        && request.resource.data.get('roundType', '').size() <= 32
        && request.resource.data.get('difficulty', '') is string
        && request.resource.data.get('difficulty', '').size() <= 32;
    }

    // ---------- MapTap Rivals - rival network ----------
    // Opt-in only: a user joins by publishing the three docs below, and
    // leaving deletes them again. Nothing here is written for a user who
    // never pressed "Join rival network".

    // Handle claim. Doc id is the lowercased maptap.gg handle, so the
    // collection doubles as the handle -> uid directory the client needs to
    // turn "my rival's maptap username" into a network member. Any signed-in
    // user can read (that lookup is the whole point); only a registered user
    // can claim, and only for their own uid. First claim wins: once the doc
    // exists, update/delete require the caller to already own it, so nobody
    // can steal someone else's handle.
    //
    // WHAT A CLAIM IS NOT: proof that the claimant owns that maptap.gg
    // account. Nothing here can establish that - it would need a server that
    // can challenge maptap.gg, and this app has none - so the product no
    // longer says it does. The app's button now reads "Look up profile", the
    // card says "Linked (not owner-verified)", and privacy.html says the
    // same. First-claim-wins plus owner-only release is the whole contract:
    // a handle taken by the wrong person is released by deleting the claim.
    match /maptapRivalsHandles/{handleLower} {
      allow read: if request.auth != null;
      allow create: if isRegistered()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isRegistered()
        && resource.data.uid == request.auth.uid;
    }

    // Published profile: handle, display name, icon, and the handles of the
    // rivals you track. This is the discovery source ("their rivals"), and
    // it is deliberately NOT readable by every member: you can read your own
    // doc, or the doc of someone you are already connected to. That is all
    // the client ever needs, because discovery only ever reads a peer you
    // already hold a pair link with, and it keeps a member's rival list from
    // being harvested by any signed-in stranger who can guess a handle
    // (handles are public on maptap.gg). Guests can neither read nor publish.
    match /maptapRivalsNetwork/{userId} {
      allow read: if isRegistered()
        && (request.auth.uid == userId || isLinkedTo(userId));
      allow write, delete: if isRegistered() && request.auth.uid == userId;
    }

    // Connected pair. Doc id is "{uidA}__{uidB}" with the uids sorted
    // lexicographically (same shape as triviaH2H above) so both sides derive
    // the same id without coordinating. Reads are restricted to the two
    // members, which also lets the client run
    // where('uids', 'array-contains', myUid) to find its own links. Create
    // requires the caller to be one of the two members; the doc is immutable
    // afterwards (no update rule) so neither side can rewrite the other's
    // handle or name. Either member may delete, which is how "delete this
    // rival" tears the connection down.
    //
    // get vs list: the client probes a specific pair id BEFORE creating it
    // (tryLinkRival's existence check). On a nonexistent doc `resource` is
    // null, so a single `read` rule touching resource.data errors and the
    // probe dies with permission-denied before the create can ever run -
    // this silently broke the first live connection attempt. So `get`
    // explicitly allows the resource == null case. The cost: a registered
    // member can probe whether two specific uids are linked, which requires
    // already knowing both uids and reveals only that a pair doc exists.
    // `list` keeps the strict membership condition, which is what actually
    // guards bulk reads.
    match /maptapRivalsLinks/{pairKey} {
      allow get: if isRegistered()
        && (resource == null || request.auth.uid in resource.data.uids);
      allow list: if isRegistered()
        && request.auth.uid in resource.data.uids;

      // A NEW link is an INVITATION, not a connection.
      //
      // It used to be both: create a document naming yourself and a stranger
      // and isLinkedTo() immediately granted you their private profile, so
      // "only connected rivals can read your profile" was a claim the caller
      // could satisfy by themselves. A new link now records exactly one
      // acceptor - its creator - and grants nothing until the other side
      // adds itself.
      //
      // The key must also be canonical: `{lower}__{higher}`. A forged id
      // (the same pair under a different key, or a key naming uids the
      // document does not) used to be writable and would then be found by a
      // membership probe that looked at the document rather than the name.
      allow create: if isRegistered()
        && request.resource.data.uids is list
        && request.resource.data.uids.size() == 2
        && request.resource.data.uids[0] is string
        && request.resource.data.uids[1] is string
        && request.resource.data.uids[0] < request.resource.data.uids[1]
        && pairKey == request.resource.data.uids[0] + '__' + request.resource.data.uids[1]
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.get('acceptedBy', []) == [request.auth.uid];

      // The ONLY update is the other side accepting. Nothing else may move:
      // neither member can rewrite the other's handle or name, which was the
      // reason this document was immutable before consent existed.
      allow update: if isRegistered()
        && request.auth.uid in resource.data.uids
        && !(request.auth.uid in resource.data.get('acceptedBy', []))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['acceptedBy', 'acceptedAt'])
        && request.resource.data.acceptedBy.hasAll(resource.data.get('acceptedBy', []))
        && request.resource.data.acceptedBy.size()
           == resource.data.get('acceptedBy', []).size() + 1
        && request.auth.uid in request.resource.data.acceptedBy
        && request.resource.data.uids.hasAll(request.resource.data.acceptedBy);

      // Either member may tear the connection down: that is "delete this
      // rival", and it is also how an unwanted invitation is declined.
      allow delete: if isRegistered()
        && request.auth.uid in resource.data.uids;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
