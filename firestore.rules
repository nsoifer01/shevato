rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: is the caller signed in with a real account (not anonymous)?
    // Arena uses anonymous sign-in for guest mode, which can play
    // ephemeral rooms but MUST NOT touch persistent collections
    // (leaderboard, H2H, daily, users/{uid}).
    function isRegistered() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Helper: is the caller connected to this MapTap Rivals member? The pair
    // link doc id is the two uids sorted lexicographically and joined by
    // '__' (see pairKey() in apps/maptap-rivals/js/network.js). Rather than
    // re-deriving that sort here, check both orderings: it costs one extra
    // exists() only on a miss, and it stays correct even if a client ever
    // writes the pair key in the other order, which a sort re-derived here
    // would silently fail to match.
    function isLinkedTo(otherUid) {
      return exists(/databases/$(database)/documents/maptapRivalsLinks/$(request.auth.uid + '__' + otherUid))
        || exists(/databases/$(database)/documents/maptapRivalsLinks/$(otherUid + '__' + request.auth.uid));
    }

    // Users can only read/write their own data. Anonymous users have no
    // persistent profile, so we explicitly block them here even though
    // their uid would otherwise match — they'd just be writing garbage
    // that nobody can ever read back after the anon session expires.
    match /users/{userId} {
      allow read, write: if isRegistered() && request.auth.uid == userId;

      // Recursive rule for all subcollections and documents
      match /{document=**} {
        allow read, write: if isRegistered() && request.auth.uid == userId;
      }
    }

    // Alternative: More granular control per namespace. NOTE — this rule
    // is shadowed by the recursive /users/{userId}/{document=**} match
    // above; Firestore unions allow rules so the permissive parent
    // disables the validation here. Kept in sync with the deployed
    // ruleset so a CLI deploy from this file doesn't drift.
    match /users/{userId}/apps/{namespace} {
      allow read: if isRegistered() && request.auth.uid == userId;

      allow write: if isRegistered()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['data', 'meta'])
        && request.resource.data.meta.keys().hasAll(['lastUpdated']);
    }

    // ---------- Trivia Arena ----------
    // Multiplayer game rooms. Any signed-in user can read any room (so
    // they can join with a code) and write to the room doc (host advances
    // questions; players touch lastSeen-style fields). Rules deliberately
    // stay loose on room-doc updates because game state is client-of-truth.
    //
    // Room passwords (defect 22): a new room may NEVER carry a cleartext
    // `password` field - the room doc is world-readable to signed-in
    // users, so the old cleartext field leaked the password to anyone
    // with the code. Private rooms instead store a hash in
    // /private/gate (below). The no-password condition applies to CREATE
    // only: legacy rooms created before this rule still carry the field
    // and must stay updatable (host advances questions with updateDoc,
    // which rewrites the full post-state including the old field) until
    // they expire.
    match /triviaRooms/{roomCode} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && !request.resource.data.keys().hasAny(['password']);
      allow update, delete: if request.auth != null;
    }
    // Password gate for private rooms: { hash: SHA-256(password + ':' +
    // code) }. Readable by NOBODY - the member-create rule below reads it
    // via get(), which bypasses client read permissions, so the hash (and
    // a fortiori the password) never becomes client-readable through this
    // doc. Only the room's creator can write it, exactly once (no
    // updates: a host swapping the hash mid-game would lock the room in a
    // way the UI never offers). Any signed-in user may delete it, same
    // looseness as the room doc itself, because the last player leaving
    // sweeps the gate alongside chat before deleting the room.
    match /triviaRooms/{roomCode}/private/{gateDoc} {
      allow read: if false;
      allow create: if request.auth != null
        && gateDoc == 'gate'
        && get(/databases/$(database)/documents/triviaRooms/$(roomCode)).data.hostUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['hash'])
        && request.resource.data.hash is string;
      allow update: if false;
      allow delete: if request.auth != null;
    }
    // Each player owns their own player doc. Score increments and answer
    // writes happen here under the player's own uid — the host can't
    // silently rewrite someone else's score.
    //
    // CREATE additionally enforces the password gate: when a
    // /private/gate doc exists, the joiner must present a matching
    // gateHash field (derived client-side from the typed password). A
    // missing or wrong hash errors the comparison, which denies. Rooms
    // without a gate doc (public rooms, plus legacy password rooms that
    // predate the gate and still use the client-side cleartext compare)
    // join exactly as before. Updates are exempt on purpose: an existing
    // player doc means the gate was already passed (reconnect-with-grace
    // rides setDoc/updateDoc on the surviving doc).
    match /triviaRooms/{roomCode}/players/{playerUid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == playerUid
        && (!exists(/databases/$(database)/documents/triviaRooms/$(roomCode)/private/gate)
            || request.resource.data.gateHash ==
               get(/databases/$(database)/documents/triviaRooms/$(roomCode)/private/gate).data.hash);
      allow update, delete: if request.auth != null
        && request.auth.uid == playerUid;
    }

    // Per-room chat. Any signed-in user can read; each user can only
    // write messages keyed by their own uid in the payload. We cap the
    // text at 280 characters so a runaway client can't spam the doc
    // with megabytes; the rules-side check is the last line of defense
    // (the client also enforces this).
    match /triviaRooms/{roomCode}/chat/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 280;
      // No edits, no recalls — keep chat append-only so moderation is
      // tractable. Hosts who want to "delete" a message can pause the
      // room or end the game instead.
      allow update, delete: if false;
    }

    // Denormalized global XP leaderboard. Read for everyone signed in
    // (guests included — they can browse the boards). Writes require a
    // real account so guest uids can't pollute the public leaderboard.
    // Admins (presence of a doc at /leaderboardAdmins/{uid}) can delete
    // any row — used to moderate stale or abusive entries.
    match /triviaLeaderboard/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isRegistered() && request.auth.uid == userId;
      allow delete: if isRegistered()
        && exists(/databases/$(database)/documents/leaderboardAdmins/$(request.auth.uid));
    }

    // Admin registry for leaderboard moderation. Each doc id is a uid;
    // presence (not the doc contents) grants admin power above. Bootstrap:
    // create the FIRST doc manually in the Firebase Console (anyone with
    // project-owner access can do it); from then on you can manage the
    // list there.
    match /leaderboardAdmins/{userId} {
      allow read: if request.auth != null;
      // Writes are deliberately closed — admin registry is managed via
      // the Firebase Console only, not in-app.
      allow write: if false;
    }

    // Brain Arena — Pairwise head-to-head records.
    // One doc per ordered uid pair (key = "{uidA}__{uidB}" with uidA <
    // uidB lexicographically). Holds Wins/Losses/Ties between those two
    // players across all multiplayer games. Read is open to any signed-
    // in user so the H2H view + lobby badges can fetch arbitrary pairs;
    // write requires the caller to actually be one of the two players
    // in the pair AND to be a registered (non-anonymous) user — guests
    // play ephemerally and shouldn't create H2H pair rows.
    match /triviaH2H/{pairKey} {
      allow read: if request.auth != null;
      allow create, update: if isRegistered()
        && (request.resource.data.uidA == request.auth.uid
            || request.resource.data.uidB == request.auth.uid);
    }

    // Brain Arena — Globe Drop daily challenge leaderboard.
    // Each YYYY-MM-DD doc has a /scores subcollection keyed by uid.
    // Anyone signed in can read (to render the daily top 10); each
    // user can only create/update their own score entry, and must be
    // a registered (non-anonymous) user so guest uids can't claim a
    // daily top spot that would orphan as soon as their session ends.
    match /globeDropDailyLeaderboard/{date}/scores/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isRegistered() && request.auth.uid == userId;
    }

    // ---------- MapTap Rivals - rival network ----------
    // Opt-in only: a user joins by publishing the three docs below, and
    // leaving deletes them again. Nothing here is written for a user who
    // never pressed "Join rival network".

    // Handle claim. Doc id is the lowercased maptap.gg handle, so the
    // collection doubles as the handle -> uid directory the client needs to
    // turn "my rival's maptap username" into a network member. Any signed-in
    // user can read (that lookup is the whole point); only a registered user
    // can claim, and only for their own uid. First claim wins: once the doc
    // exists, update/delete require the caller to already own it, so nobody
    // can steal someone else's handle.
    match /maptapRivalsHandles/{handleLower} {
      allow read: if request.auth != null;
      allow create: if isRegistered()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isRegistered()
        && resource.data.uid == request.auth.uid;
    }

    // Published profile: handle, display name, icon, and the handles of the
    // rivals you track. This is the discovery source ("their rivals"), and
    // it is deliberately NOT readable by every member: you can read your own
    // doc, or the doc of someone you are already connected to. That is all
    // the client ever needs, because discovery only ever reads a peer you
    // already hold a pair link with, and it keeps a member's rival list from
    // being harvested by any signed-in stranger who can guess a handle
    // (handles are public on maptap.gg). Guests can neither read nor publish.
    match /maptapRivalsNetwork/{userId} {
      allow read: if isRegistered()
        && (request.auth.uid == userId || isLinkedTo(userId));
      allow write, delete: if isRegistered() && request.auth.uid == userId;
    }

    // Connected pair. Doc id is "{uidA}__{uidB}" with the uids sorted
    // lexicographically (same shape as triviaH2H above) so both sides derive
    // the same id without coordinating. Reads are restricted to the two
    // members, which also lets the client run
    // where('uids', 'array-contains', myUid) to find its own links. Create
    // requires the caller to be one of the two members; the doc is immutable
    // afterwards (no update rule) so neither side can rewrite the other's
    // handle or name. Either member may delete, which is how "delete this
    // rival" tears the connection down.
    //
    // get vs list: the client probes a specific pair id BEFORE creating it
    // (tryLinkRival's existence check). On a nonexistent doc `resource` is
    // null, so a single `read` rule touching resource.data errors and the
    // probe dies with permission-denied before the create can ever run -
    // this silently broke the first live connection attempt. So `get`
    // explicitly allows the resource == null case. The cost: a registered
    // member can probe whether two specific uids are linked, which requires
    // already knowing both uids and reveals only that a pair doc exists.
    // `list` keeps the strict membership condition, which is what actually
    // guards bulk reads.
    match /maptapRivalsLinks/{pairKey} {
      allow get: if isRegistered()
        && (resource == null || request.auth.uid in resource.data.uids);
      allow list: if isRegistered()
        && request.auth.uid in resource.data.uids;
      allow create: if isRegistered()
        && request.resource.data.uids.size() == 2
        && request.auth.uid in request.resource.data.uids;
      allow delete: if isRegistered()
        && request.auth.uid in resource.data.uids;
      allow update: if false;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
