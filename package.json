{
  "name": "shevato",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "commonjs",
  "scripts": {
    "pretest": "node scripts/require-node.mjs",
    "test": "node --test \"apps/gym-tracker/tests/**/*.test.*\" \"apps/football-h2h/tests/**/*.test.*\" \"apps/fpl-planner/tests/**/*.test.*\" \"apps/rising-shows/tests/**/*.test.*\" \"apps/mario-kart/tests/**/*.test.*\" \"apps/arena/tests/**/*.test.*\" \"apps/maptap-rivals/tests/**/*.test.*\" \"apps/trip-planner/tests/**/*.test.*\" \"netlify/functions/tests/**/*.test.*\" \"sync-system/tests/**/*.test.*\" \"assets/js/tests/**/*.test.*\" \"tests/static/**/*.test.*\"",
    "lint": "eslint .",
    "test:browser": "node --experimental-websocket tests/browser/run.mjs",
  "test:browser:parallel": "node --experimental-websocket tests/browser/run-parallel.mjs",
    "test:coverage": "node tests/coverage/run.mjs",
    "test:cross-browser": "node --test \"tests/cross-browser/**/*.test.*\"",
    "test:static": "node --test \"tests/static/**/*.test.*\"",
    "test:all": "npm run lint && npm test && npm run test:browser",
    "test:trip-planner:e2e": "node --experimental-websocket tests/browser/run.mjs --only=trip-planner",
    "test:fpl-planner:e2e": "node --experimental-websocket tests/browser/run.mjs --only=fpl-planner",
    "test:maptap-rivals:e2e": "node --experimental-websocket tests/browser/run.mjs --only=maptap-rivals",
    "test:trip-planner:e2e:headed": "node --experimental-websocket tests/browser/run.mjs --only=trip-planner --headed",
    "test:gym": "node --test \"apps/gym-tracker/tests/**/*.test.*\"",
    "test:football": "node --test \"apps/football-h2h/tests/**/*.test.*\"",
    "test:fpl-planner": "node --test \"apps/fpl-planner/tests/**/*.test.*\"",
    "test:rising-shows": "node --test \"apps/rising-shows/tests/**/*.test.*\"",
    "test:mario-kart": "node --test \"apps/mario-kart/tests/**/*.test.*\"",
    "test:arena": "node --test \"apps/arena/tests/**/*.test.*\"",
    "test:arena:rules": "node --test \"apps/arena/tests-rules/**/*.test.*\"",
    "test:arena:emulator": "node --experimental-websocket apps/arena/e2e/run-emulator.mjs",
    "test:maptap": "node --test \"apps/maptap-rivals/tests/**/*.test.*\"",
    "test:trip-planner": "node --test \"apps/trip-planner/tests/**/*.test.*\"",
    "test:tp-assist-quota": "node --test netlify/functions/tests/tp-assist-quota.test.mjs",
    "test:sync": "node --test \"sync-system/tests/**/*.test.*\"",
    "test:analytics": "node --test \"assets/js/tests/**/*.test.*\"",
    "sync:mario-kart-courses": "node apps/mario-kart/scripts/sync-courses.mjs",
    "build:trip-planner:airports": "node apps/trip-planner/scripts/build-airports.mjs",
    "build:rising-shows": "node apps/rising-shows/scripts/build-data.js",
    "build:rising-shows:pages": "node apps/rising-shows/scripts/build-show-pages.js",
    "build:gym-tracker:pages": "node apps/gym-tracker/scripts/build-exercise-pages.cjs",
    "build:rising-shows:split": "node --max-old-space-size=4096 apps/rising-shows/scripts/split-data.js",
    "build:site": "node apps/rising-shows/scripts/fetch-data.js && node apps/rising-shows/scripts/build-show-pages.js && node apps/gym-tracker/scripts/build-exercise-pages.cjs && node --max-old-space-size=4096 apps/rising-shows/scripts/split-data.js && node scripts/inline-partials.mjs && node scripts/stamp-release.mjs && node scripts/stamp-sitemap-index.mjs && node scripts/build-publish-dir.mjs",
    "fetch:rising-shows-data": "node apps/rising-shows/scripts/fetch-data.js",
    "build:og-cards": "node assets/og/build-og-cards.mjs",
    "enrich:rising-shows": "node apps/rising-shows/scripts/enrich-tmdb.js",
    "enrich:rising-shows:providers": "node apps/rising-shows/scripts/enrich-providers.js",
    "export:rising-shows": "node apps/rising-shows/scripts/export-integrations.js",
    "watch-next": "node apps/rising-shows/scripts/watch-next.js"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.13"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "playwright": "1.62.1"
  }
}
