# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore temp files
.*.sw*

# Root npm dependencies: Playwright for the cross-browser smoke suite
# (devDependency) and @netlify/blobs, declared here so the Netlify functions
# bundle resolves it. Browser code has zero npm dependencies by design.
#
# No trailing slash, deliberately. `/node_modules/` matches a DIRECTORY only,
# so a symlink named node_modules is NOT ignored by it - one was committed
# that way on 2026-08-23 (0ce12b9). Guarded by
# tests/static/tracked-symlinks.test.mjs.
/node_modules

# Coverage reports written by tests/coverage/run.mjs
/.coverage/

# Environment variables
.env
.env.local
.env.production

# Netlify
.netlify/
netlify/functions/node_modules
netlify/functions/package-lock.json

# Firebase local config (if you want a different local config)
assets/js/firebase-config-local.js

# WhatsApp chat exports (personal data, used locally for MapTap Rivals import)
WhatsApp Chat *.txt
WhatsApp Chat *.txt:Zone.Identifier

# Windows / WSL download metadata
*:Zone.Identifier

# Rising Shows static SEO pages — derived from data.json at build
# time (Netlify or the GitHub Actions refresh workflow). Not committed
# to keep git history clean.
apps/rising-shows/shows/
apps/rising-shows/sitemap-shows.xml

# Rising Shows datasets — published to the rolling "rising-shows-data"
# GitHub release by the refresh workflow and downloaded at build time
# (scripts/fetch-data.js). Never committed: the pair is ~150 MB per
# refresh and was bloating git history.
apps/rising-shows/data.json
apps/rising-shows/data/show-modal-extras.json

# Derived from data.json by scripts/split-data.js at build time.
# shows-index.json is the payload the browser fetches at boot (one record per
# show, already aggregated); data-index.json is the season-level file the build
# and the dataset artifact keep; data/kometa-index.json is the season slice the
# Kometa builder page reads; data/detail/ holds one small file per series with
# that show's season records and per-episode data, fetched when a modal opens.
# Build artifacts, so never committed - together they are ~60 MB per refresh,
# and detail/ alone is ~34,600 files.
apps/rising-shows/shows-index.json
apps/rising-shows/data-index.json
apps/rising-shows/data/kometa-index.json
apps/rising-shows/data/detail/

# Gym Tracker static SEO pages — derived from exercises-db.json at
# build time. Same rationale as Rising Shows.
apps/gym-tracker/exercises/
apps/gym-tracker/sitemap-exercises.xml

# Local-only change-notes / site-comparison docs. Kept on disk for
# reference, not published to the repo.
.features/

# Transient test-run screenshot evidence (written by the test pipeline,
# reviewed by the owner, deleted at round close). Never committed.
.screenshots/


# Owner-uploaded reference screenshots (Lightshot drops for design review).
# Local-only working material, never published to the repo.
.lightshot-screenshots/

# Netlify Edge Functions lockfile, generated by `netlify dev`
deno.lock

# Firebase emulator artifacts (written by `firebase emulators:*`, e.g. when
# validating firestore.rules locally). Local-only, never committed.
*-debug.log
.firebase/

# FPL Planner training data, downloaded by apps/fpl-planner/scripts/fetch-history.mjs
apps/fpl-planner/.data/

# FPL Planner availability data, downloaded by apps/fpl-planner/scripts/fetch-availability.mjs
apps/fpl-planner/.data/availability/

# Per-app and site-level session reports (owner-reviewed, machine-local)
apps/*/.reports/
.reports/

# Local headless-Chrome profiles used by manual verification runs.
.chrome-profiles/

# The publish directory. scripts/build-publish-dir.mjs rmSync()s and rebuilds it
# from scratch on every `npm run build:site`, so a copy on disk is never the
# source of anything - and a stale one is a live hazard, because
# `netlify deploy --prod --no-build` publishes whatever bytes it finds.
dist/

# Audit evidence: the probe scripts, logs and per-phase findings files an audit
# round writes beside its summary (apps/trip-planner/AUDIT-2026-08-22.md names
# this path and already described it as ignored). The summary that survives the
# round is committed; the evidence is not.
.audit/

# node:test reporter output. The unit job in ci.yml runs with
# `--test-reporter=junit --test-reporter-destination=unit-tests.junit.xml` and
# `--test-reporter=./scripts/test-file-times.mjs --test-reporter-destination=unit-file-times.md`,
# so reproducing a CI run locally drops both at the repo root.
*.junit.xml
*file-times.md

# ESLint's optional on-disk cache (`eslint --cache`).
.eslintcache

# Debugging dumps: V8 profiles and heap snapshots from a performance
# investigation. Read them, then delete them - they are never a repo artifact.
*.cpuprofile
*.heapsnapshot

# Merge and patch leftovers.
*.orig
*.rej
